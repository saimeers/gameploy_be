# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Origen permitido por CORS y base de los enlaces enviados por correo
FRONTEND_URL=http://localhost:5173

# Nombre mostrado en los correos transaccionales
APP_NAME=Gameploy

# Memoria máxima (MB) para la caché de builds antiguos servidos por /play
PLAY_CACHE_MB=256

# URL pública de esta API (con /api/v1). En desarrollo, base del CDN local.
API_PUBLIC_URL=http://localhost:3000/api/v1

# Peticiones por IP cada 15 minutos (el login tiene su propio límite de 20)
RATE_LIMIT_MAX=1000

# ── Base de datos ─────────────────────────────────────────────────────────────
# En local se usa el host público del proveedor (*.proxy.rlwy.net con su puerto).
# El host interno (*.railway.internal:5432) solo resuelve dentro de Railway: es el
# que debe configurarse en las variables del servicio desplegado, no aquí.
DATABASE_URL=postgresql://usuario:password@host:5432/gameploy

# ── Firebase Admin SDK (cuenta de servicio) ───────────────────────────────────
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
# Entre comillas y con los saltos de línea escapados como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Bucket S3-compatible (archivos de los juegos) ─────────────────────────────
RAILWAY_BUCKET_ENDPOINT=https://bucket.tu-proveedor.com
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_ACCESS_KEY=
RAILWAY_BUCKET_SECRET_KEY=
RAILWAY_BUCKET_NAME=gameploy

# ── CDN: Cloudflare R2 + Worker (juegos e imágenes) ───────────────────────────
# Sin R2_BUCKET, en desarrollo los archivos se publican en PUBLIC_FILES_DIR y los
# sirve esta API en /api/v1/cdn con los mismos enlaces firmados; en producción
# sin R2 no se publica nada y los juegos se sirven por /play.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio del Worker, sin barra final (p. ej. https://cdn-gameploy.saimers.dev)
CDN_URL=
# El mismo secreto que tiene el Worker (wrangler secret put CDN_SIGNING_SECRET)
CDN_SIGNING_SECRET=
# Duración de los enlaces firmados: valen entre 1 y 2 veces este valor
CDN_TOKEN_TTL_MIN=60
# Carpeta del CDN local de desarrollo (por defecto ./.public-files)
PUBLIC_FILES_DIR=

# ── Redis (caché, límites de peticiones y visitas únicas) ─────────────────────
# Opcional: sin él todo funciona en memoria. En Railway: ${{Redis.REDIS_URL}}
REDIS_URL=
# Secreto para el hash del visitante con el que se cuentan visitas únicas
VISIT_SALT=

# ── Correo (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gameploy <no-reply@tu-dominio.com>
# Destinatario de los avisos de registros pendientes de aprobación
ADMIN_EMAIL=
