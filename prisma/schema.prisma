generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  estudiante
  docente
  pendiente
}

enum ProjectStatus {
  borrador
  publicado
  archivado
}

enum ProjectVisibility {
  publico
  privado
  por_enlace
}

enum FileType {
  juego_webgl
  portada
  captura
}

enum InputType {
  teclado
  mouse
  mando
  mobile
}

/// Who answered the usability survey: the role of the account, or visitante.
enum SurveyProfile {
  estudiante
  docente
  visitante
}

/// What led to the answer: the invitation that was shown, or voluntaria.
enum SurveyMoment {
  primer_proyecto
  uso_prolongado
  tras_jugar
  voluntaria
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      RoleName @unique
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id             String   @id @default(uuid())
  firebase_uid   String   @unique
  nombre         String
  correo         String   @unique
  activo         Boolean  @default(true)
  fecha_registro DateTime @default(now())
  id_rol         Int
  rol            Rol      @relation(fields: [id_rol], references: [id])
  rol_solicitado RoleName?
  proyectos      Proyecto[]
  comentarios    Comentario[]

  /// Only whether the user answered the survey, never when: the answer itself
  /// is anonymous and must not be traceable back to the account.
  encuesta_respondida      Boolean   @default(false)
  encuesta_pospuestas      Int       @default(0)
  encuesta_pospuesta_hasta DateTime?
  /// Days on which the user opened the platform, to invite long-time users.
  dias_activos             Int       @default(0)
  ultimo_dia_activo        DateTime? @db.Date

  @@map("usuarios")
}

/// Categories and tags are deactivated rather than deleted: an inactive one is
/// no longer offered for new projects, but the projects that use it keep it.
model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  activo      Boolean    @default(true)
  proyectos   Proyecto[]

  @@map("categorias")
}

model Etiqueta {
  id        Int                @id @default(autoincrement())
  nombre    String             @unique
  activo    Boolean            @default(true)
  proyectos ProyectoEtiqueta[]

  @@map("etiquetas")
}

model Proyecto {
  id                String            @id @default(uuid())
  nombre            String
  descripcion       String?
  instrucciones     String?
  slug              String            @unique
  estado            ProjectStatus     @default(borrador)
  visibilidad       ProjectVisibility @default(privado)
  destacado         Boolean           @default(false)
  fecha_creacion    DateTime          @default(now())
  fecha_publicacion DateTime?
  id_usuario        String
  usuario           Usuario           @relation(fields: [id_usuario], references: [id])
  id_categoria      Int?
  categoria         Categoria?        @relation(fields: [id_categoria], references: [id])
  etiquetas         ProyectoEtiqueta[]
  versiones         VersionProyecto[]
  controles         ControlJuego[]
  comentarios       Comentario[]
  visitas           Visita[]
  slugs_anteriores  SlugAnterior[]

  @@map("proyectos")
}

/// Slugs a project had before its owner changed it. They keep the links that
/// were already shared working, and no other project can take them.
model SlugAnterior {
  slug         String   @id
  fecha_cambio DateTime @default(now())
  id_proyecto  String
  proyecto     Proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@index([id_proyecto])
  @@map("slugs_anteriores")
}

model ProyectoEtiqueta {
  id_proyecto String
  id_etiqueta Int
  proyecto    Proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  etiqueta    Etiqueta @relation(fields: [id_etiqueta], references: [id], onDelete: Cascade)

  @@id([id_proyecto, id_etiqueta])
  @@map("proyecto_etiquetas")
}

model VersionProyecto {
  id             String    @id @default(uuid())
  numero_version String
  notas_version  String?
  es_activa      Boolean   @default(false)
  fecha_subida   DateTime  @default(now())
  id_proyecto    String
  proyecto       Proyecto  @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  archivos       Archivo[]

  @@map("versiones_proyecto")
}

model Archivo {
  id             String          @id @default(uuid())
  tipo           FileType
  nombre_archivo String
  ruta_storage   String
  /// Published copy that players download (R2 or the local dev folder):
  /// builds/<id>/ for a game, media/<id>/<name> for an image. Null when not
  /// published yet. Inherited rows share it, like ruta_storage.
  ruta_publica   String?
  /// Files of a published game build with their sizes and upload checks.
  manifiesto     Json?
  tamanio_bytes  BigInt
  fecha_subida   DateTime        @default(now())
  id_version     String
  version        VersionProyecto @relation(fields: [id_version], references: [id], onDelete: Cascade)

  @@map("archivos")
}

model ControlJuego {
  id                 String    @id @default(uuid())
  tipo_entrada       InputType
  tecla_boton        String
  descripcion_accion String
  orden              Int       @default(0)
  id_proyecto        String
  proyecto           Proyecto  @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@map("controles_juego")
}

model Comentario {
  id           String   @id @default(uuid())
  contenido    String
  calificacion Int?
  activo       Boolean  @default(true)
  fecha        DateTime @default(now())
  id_proyecto  String
  proyecto     Proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)
  id_usuario   String
  usuario      Usuario  @relation(fields: [id_usuario], references: [id])

  @@map("comentarios")
}

model Visita {
  id          String   @id @default(uuid())
  fecha       DateTime @default(now())
  origen      String?
  /// Location resolved from the visitor's IP when the visit is recorded. The
  /// IP itself is never stored.
  codigo_pais String?  @db.Char(2)
  region      String?
  ciudad      String?
  id_proyecto String
  proyecto    Proyecto @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@index([id_proyecto, fecha])
  @@map("visitas")
}

/// Anonymous answer to the usability (SUS) and experience questionnaire about
/// the platform. It keeps no user, email or IP, and only the day it was sent.
model RespuestaEncuesta {
  id                      String        @id @default(uuid())
  fecha                   DateTime      @default(now()) @db.Date
  /// Version of the questions in src/config/encuesta.js
  version                 Int
  perfil                  SurveyProfile
  momento                 SurveyMoment
  edad                    String?
  genero                  String?
  experiencia_videojuegos String?
  frecuencia_juego        String?
  juegos_serios_previos   String?
  /// The ten SUS answers, 1 (totally disagree) to 5 (totally agree), in order.
  sus                     Int[]
  /// The ten experience answers, same scale, in order.
  ux                      Int[]
  /// 0 to 100, standard SUS scoring.
  sus_puntaje             Float
  /// 0 to 100, mean agreement with the negative items reversed.
  ux_puntaje              Float
  comentario              String?

  @@index([fecha])
  @@map("respuestas_encuesta")
}